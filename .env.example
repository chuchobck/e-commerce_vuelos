# Copia este archivo como .env (nunca se sube .env al repositorio).

# --- API de vuelos -----------------------------------------------------------------------------
# Vacía: se usa la API simulada (mock) para TODO (también la cuenta), con las pistas "Para probar".
# Con valor: todo va a la API real por REST. Nunca se mezclan el mock y lo real.
#
# Qué ruta va a qué servicio (con valor):
#   VITE_API_URL       compra, postventa y el respaldo REST de las lecturas      → core    (/flights/v1)
#   VITE_IDENTITY_URL  register, login, refresh, logout y me                     → identity (/identity/v1)
#   VITE_GRAPHQL_URL   búsqueda, mapa de asientos y estado de vuelo              → BFF      (/graphql)
VITE_API_URL=

# Detrás del gateway (la forma de producción): una sola entrada pública para los tres servicios.
# VITE_API_URL=https://<gateway>/flights/v1
# VITE_GRAPHQL_URL=https://<gateway>/graphql
# (VITE_IDENTITY_URL se deriva sola: https://<gateway>/identity/v1)

# Gateway local (scripts/e2e-local.sh del repo gateway_vuelos; su CORS_ORIGINS debe incluir http://localhost:5173):
# VITE_API_URL=http://localhost:8080/flights/v1
# VITE_GRAPHQL_URL=http://localhost:8080/graphql

# Servicios locales sin gateway (cada uno con CORS_ORIGINS=http://localhost:5173):
# VITE_API_URL=http://localhost:3000/flights/v1
# VITE_IDENTITY_URL=http://localhost:3001/identity/v1
# VITE_GRAPHQL_URL=http://localhost:4000/graphql

# Backend viejo con login propio (AUTH_MODE=local): la cuenta en la misma base que la API.
# VITE_API_URL=http://localhost:3010/flights/v1
# VITE_IDENTITY_URL=http://localhost:3010/flights/v1

# Render: solo para verificar (plan gratuito: duerme tras 15 min y tarda ~1 min en despertar).
# Su CORS no incluye localhost, así que desde el navegador no sirve en desarrollo; se usa con
# `npm run test:api` (corre en Node y no necesita CORS).
# VITE_API_URL=https://quinde-vuelos-api.onrender.com/flights/v1

# --- Cuenta (identity, Reto 2 fase 6c) ----------------------------------------------------------------
# Base de identity: ahí van register, login, refresh, logout y me ({base}/auth/*). El Bearer que entrega viaja
# igual al core por el gateway. Solo cuenta si VITE_API_URL tiene valor; con la API vacía (mock) se ignora.
# Vacía: se deriva de VITE_API_URL cambiando el sufijo /flights/v1 por /identity/v1
#   (https://gw/flights/v1 → https://gw/identity/v1). Si VITE_API_URL no termina en /flights/v1, no hay de dónde
#   derivarla y la cuenta queda en VITE_API_URL (el login propio del core). Con valor: se usa esa, tal cual.
VITE_IDENTITY_URL=

# --- BFF GraphQL (Reto 2) ---------------------------------------------------------------------------
# Solo cuenta si VITE_API_URL tiene valor; con la API vacía (mock) se ignora.
# Vacía: las tres lecturas públicas van por REST al core (el modo de respaldo, igual que siempre).
# Con valor: búsqueda, mapa de asientos y estado de vuelo van por GraphQL al BFF; cuenta, compra y
# postventa no pasan por el BFF.
# El BFF (o el gateway delante) debe tener CORS_ORIGINS=http://localhost:5173.
VITE_GRAPHQL_URL=

# Último día con salidas en la semilla del backend (yyyy-MM-dd). La semilla genera 90 días desde
# su carga y esa ventana es fija: el buscador no deja elegir fechas posteriores. Vacía = hoy + 89 días.
VITE_LAST_FLIGHT_DATE=

# --- Solo para el mock ---------------------------------------------------------------------------
# Tasa de errores aleatorios (0 a 1). Por defecto 0.08.
VITE_MOCK_ERROR_RATE=0.08
