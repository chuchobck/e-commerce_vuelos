# Copia este archivo como .env (nunca se sube .env al repositorio).

# --- API de vuelos -----------------------------------------------------------------------------
# Vacía: se usa la API simulada (mock) para TODO, con las pistas "Para probar".
# Con valor: todo va a la API real por REST (cuenta, compra, postventa y las tres lecturas públicas).
# Nunca se mezclan el mock y lo real.
VITE_API_URL=

# Desarrollo (recomendado): el backend local. Debe tener CORS_ORIGINS=http://localhost:5173.
# Desde Windows con el backend en WSL funciona "localhost" (127.0.0.1 no llega).
# VITE_API_URL=http://localhost:3010/flights/v1

# Render: solo para verificar (plan gratuito: duerme tras 15 min y tarda ~1 min en despertar).
# Su CORS no incluye localhost, así que desde el navegador no sirve en desarrollo; se usa con
# `npm run test:api` (corre en Node y no necesita CORS).
# VITE_API_URL=https://quinde-vuelos-api.onrender.com/flights/v1

# --- BFF GraphQL (Reto 2) ---------------------------------------------------------------------------
# Solo cuenta si VITE_API_URL tiene valor; con la API vacía (mock) se ignora.
# Vacía: las tres lecturas públicas van por REST al core (el modo de respaldo, igual que siempre).
# Con valor: búsqueda, mapa de asientos y estado de vuelo van por GraphQL al BFF; cuenta, compra y
# postventa siguen por REST directo al core, con Bearer e Idempotency-Key.
# El BFF debe tener CORS_ORIGINS=http://localhost:5173.
VITE_GRAPHQL_URL=
# VITE_GRAPHQL_URL=http://localhost:4000/graphql

# Último día con salidas en la semilla del backend (yyyy-MM-dd). La semilla genera 90 días desde
# su carga y esa ventana es fija: el buscador no deja elegir fechas posteriores. Vacía = hoy + 89 días.
VITE_LAST_FLIGHT_DATE=

# --- Solo para el mock ---------------------------------------------------------------------------
# Tasa de errores aleatorios (0 a 1). Por defecto 0.08.
VITE_MOCK_ERROR_RATE=0.08
